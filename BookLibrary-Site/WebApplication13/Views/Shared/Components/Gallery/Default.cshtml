@model IEnumerable<WebApplication13.Models.ImageModel>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <img src="@item.FilePath" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;" />
                <div class="card-body">
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text">@item.Description</p>
                </div>
            </div>
        </div>
    }
</div>  