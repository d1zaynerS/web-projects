@model IEnumerable<WebApplication13.Models.Product>

<form method="get" class="row g-3 mb-4 p-3 border rounded">
    <div class="col-md-3">
        <label class="form-label">Категорія</label>
        <select name="category" class="form-select">
            <option value="">Всі категорії</option>
            @if (ViewBag.Categories != null)
            {
                foreach (string cat in ViewBag.Categories)
                {
                    <option value="@cat">@cat</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Макс. ціна</label>
        <input type="number" name="maxPrice" class="form-control" placeholder="До грн" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Сортування</label>
        <select name="sortBy" class="form-select">
            <option value="name">За назвою</option>
            <option value="price_asc">Ціна (від дешевших)</option>
            <option value="price_desc">Ціна (від дорожчих)</option>
            <option value="popularity">За популярністю</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-success w-100">Застосувати</button>
    </div>
</form>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@item.Category</h6>
                    <p class="card-text">@item.Description</p>
                    <p class="fw-bold">Ціна: @item.Price грн</p>
                </div>
            </div>
        </div>
    }
</div>