@model PizzaStar.Models.Pages.PagedList<PizzaStar.Models.Category>

@{
    ViewData["Title"] = "Категорії";
}

<div class="container mt-4">
    <h2>Управління категоріями</h2>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">Створити нову категорію</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Назва</th>
                <th>Опис</th>
                <th>Зображення</th>
                <th>Дата публікації</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="@item.Image" alt="@item.Name" style="max-width: 80px; max-height: 80px;" />
                            }
                            else
                            {
                                <span>Немає фото</span>
                            }
                        </td>
                        <td>@item.DateOfPublication.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редагувати</a>


                            <button type="button"
                                    class="btn btn-sm btn-danger btn-delete-category"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteCategoryModal"
                                    data-id="@item.Id"
                                    data-name="@item.Name">
                                Видалити
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">Категорії відсутні.</td>
                </tr>
            }
        </tbody>
    </table>
</div>


<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-labelledby="deleteCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteCategoryModalLabel">Підтвердження видалення</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deleteCategoryForm" method="post" asp-action="Delete">
                <div class="modal-body">
                    <input type="hidden" id="deleteCategoryId" name="id" />
                    <p>Ви дійсно бажаєте видалити категорію <strong id="deleteCategoryName"></strong>?</p>
                    <p class="text-danger mb-0"><small>Цю дію неможливо скасувати.</small></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-danger">Так, видалити</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const deleteButtons = document.querySelectorAll(".btn-delete-category");
            const modalCategoryId = document.getElementById("deleteCategoryId");
            const modalCategoryName = document.getElementById("deleteCategoryName");
            const deleteForm = document.getElementById("deleteCategoryForm");

            deleteButtons.forEach(button => {
                button.addEventListener("click", function () {
                    const id = this.getAttribute("data-id");
                    const name = this.getAttribute("data-name");

                    modalCategoryId.value = id;
                    modalCategoryName.textContent = name;
                    deleteForm.action = `/panel/categories/delete/${id}`;
                });
            });
        });
    </script>
}