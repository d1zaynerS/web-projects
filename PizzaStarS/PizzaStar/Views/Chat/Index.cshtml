@model IEnumerable<PizzaStar.Models.Message>
@{
    ViewData["Title"] = "Загальний чат";
}

<div class="container mt-4">
    <h2>Загальний чат та Онлайн користувачі</h2>
    <div class="row">

        <div class="col-md-8">
            <div id="chatBox" class="border p-3 mb-3" style="height: 400px; overflow-y: scroll; background: #f9f9f9;">
                @foreach (var msg in Model)
                {
                    <div class="mb-2" id="msg-@msg.Id">
                        <strong>@msg.Sender?.UserName</strong> <small class="text-muted">@msg.SentAt.ToString("HH:mm")</small>:
                        <span>@msg.Content</span>
                        @if (msg.Sender?.UserName == User.Identity.Name || User.IsInRole("Admin"))
                        {
                            <button class="btn btn-sm btn-danger float-end" onclick="deleteMessage(@msg.Id)">Видалити</button>
                        }
                    </div>
                }
            </div>
            <div class="input-group">
                <input type="text" id="messageInput" class="form-control" placeholder="Введіть повідомлення..." />
                <button id="sendButton" class="btn btn-primary">Надіслати</button>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-success text-white">Користувачі Онлайн</div>
                <ul id="onlineUsersList" class="list-group list-group-flush">

                </ul>
            </div>
        </div>
    </div>
</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

    connection.on("ReceiveMessage", function (user, message, time, messageId) {
        let msgBox = document.getElementById("chatBox");
        let div = document.createElement("div");
        div.className = "mb-2";
        div.id = "msg-" + messageId;
        div.innerHTML = `<strong>${user}</strong> <small class="text-muted">${time}</small>: <span>${message}</span> <button class="btn btn-sm btn-danger float-end" onclick="deleteMessage(${messageId})">Видалити</button>`;
        msgBox.appendChild(div);
        msgBox.scrollTop = msgBox.scrollHeight;
    });

    connection.on("MessageDeleted", function (messageId) {
        let msgElement = document.getElementById("msg-" + messageId);
        if (msgElement) msgElement.remove();
    });

    connection.on("UpdateOnlineUsers", function (users) {
        let list = document.getElementById("onlineUsersList");
        list.innerHTML = "";
        users.forEach(user => {
            let li = document.createElement("li");
            li.className = "list-group-item";
            li.textContent = user;
            list.appendChild(li);
        });
    });

    connection.start().catch(err => console.error(err.toString()));

    document.getElementById("sendButton").addEventListener("click", function () {
        let message = document.getElementById("messageInput").value;
        if (message.trim() !== "") {
            connection.invoke("SendMessage", message).catch(err => console.error(err.toString()));
            document.getElementById("messageInput").value = "";
        }
    });

    function deleteMessage(id) {
        connection.invoke("DeleteMessage", id).catch(err => console.error(err.toString()));
    }
</script>