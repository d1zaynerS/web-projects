@model PizzaStar.Models.Category

@{
    ViewData["Title"] = "Редагувати категорію";
}

<div class="container mt-4">
    <h2>Редагувати категорію</h2>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="DateOfPublication" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Назва категорії</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Опис</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Image" class="form-label">URL зображення</label>
            <input asp-for="Image" class="form-control" />
            <span asp-validation-for="Image" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Зберегти зміни</button>
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>